# =============================================================================
# NotebookLLM Server — Environment Variables
# =============================================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in each value below (never commit .env to git)
# 3. Start Postgres:  docker compose up -d   (see docker-compose.yml)
# 4. Run migrations:  npx prisma migrate deploy && npx prisma generate
# =============================================================================


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# Express API port (client proxies /api to this URL via next.config.ts)
PORT=8081

# PostgreSQL connection string
# Default matches docker-compose.yml: user=bookllm, password=postgres, db=bookllm, host port=5433
DATABASE_URL="postgresql://bookllm:postgres@localhost:5433/bookllm"

# Next.js frontend origin (used for CORS and Better Auth trusted origins)
CLIENT_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Authentication (Better Auth + Google OAuth)
# -----------------------------------------------------------------------------

# Long random string for signing sessions (generate with: openssl rand -base64 32)
# Note: auth.ts reads process.env.Better_Auth_Secret — set that name OR align with BETTER_AUTH_SECRET in your .env
BETTER_AUTH_SECRET=

# Public URL of this API (same host/port as PORT above)
BETTER_AUTH_URL=http://localhost:8081

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# Authorized redirect URI: http://localhost:8081/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# OpenAI (required — chat, embeddings, artifact generation)
# -----------------------------------------------------------------------------

# https://platform.openai.com/api-keys
OPENAI_API_KEY=


# -----------------------------------------------------------------------------
# Pinecone (required — RAG vector search)
# -----------------------------------------------------------------------------

# https://app.pinecone.io/
PINECONE_API_KEY=

# Index name; must exist with 1536 dimensions (text-embedding-3-small)
PINECONE_INDEX=bookllm


# -----------------------------------------------------------------------------
# Inngest (required for local dev — background jobs)
# -----------------------------------------------------------------------------

# Set to 1 when using: npm run dev:inngest  (dashboard at http://localhost:8288)
INNGEST_DEV=1


# -----------------------------------------------------------------------------
# Cloudinary (optional — PDF uploads)
# -----------------------------------------------------------------------------

# https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=bookllm
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# -----------------------------------------------------------------------------
# Firecrawl (optional — website source import)
# -----------------------------------------------------------------------------

# https://www.firecrawl.dev/
FIRECRAWL_API_KEY=


# -----------------------------------------------------------------------------
# Tavily (optional — web search toggle in chat)
# -----------------------------------------------------------------------------

# https://tavily.com/
TAVILY_API_KEY=


# -----------------------------------------------------------------------------
# Mem0 (optional — user memory in Settings → Memory)
# -----------------------------------------------------------------------------

# https://mem0.ai/
MEM0_API_KEY=
