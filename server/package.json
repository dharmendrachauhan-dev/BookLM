{
  "name": "Notebook-Server",
  "module": "index.ts",
  "type": "module",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "dev": "tsx watch ./src/index.ts",
    "dev:inngest": "npx inngest-cli@latest dev -u http://localhost:8081/api/inngest",
    "dev:all": "npx concurrently -n server,inngest -c blue,magenta \"npm run dev\" \"npm run dev:inngest\"",
    "start": "bun run index.ts",
    "build": "tsc"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.42",
    "@mendable/firecrawl-js": "4.32.0",
    "@pinecone-database/pinecone": "^8.2.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tavily/core": "^0.7.7",
    "ai": "^7.0.66",
    "better-auth": "^1.6.27",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firecrawl": "^4.32.2",
    "inngest": "^4.18.1",
    "mem0ai": "^3.1.6",
    "multer": "^2.2.0",
    "openai": "^7.4.0",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "unpdf": "^1.8.1",
    "youtube-transcript": "^1.3.1",
    "zod": "^4.4.3"
  }
}
